---
import { languageForPath, localizedPath, languageLabels, languages } from '../data/languages';
const language = languageForPath(Astro.url.pathname);
const selected = languages.find(({ code }) => code === language)!;
---

<details class="language-toggle">
  <summary aria-label={languageLabels[language]}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" />
    </svg>
    <span>{selected.label}</span>
  </summary>
  <ul class="language-menu">
    {languages.map(({ code, label, htmlLang }) => (
      <li><a href={localizedPath(Astro.url.pathname, code)} lang={htmlLang} hreflang={htmlLang} aria-current={code === language ? 'true' : undefined}>{label}</a></li>
    ))}
  </ul>
</details>

---
import type { LocalizedString } from '../data/site';
import { languages } from '../data/languages';

type Props = {
  value: LocalizedString;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
};

const { value, as = 'span', class: className } = Astro.props as Props;
const Tag = as;
---

<Tag class={className}>
  {languages.map(({ code, htmlLang }) => <span data-locale={code} lang={htmlLang}>{value[code]}</span>)}
</Tag>

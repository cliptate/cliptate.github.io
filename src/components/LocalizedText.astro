---
import type { LocalizedString } from '../data/site';
import { languages, languageForPath } from '../data/languages';

type Props = {
  value: LocalizedString;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
};

const { value, as = 'span', class: className } = Astro.props as Props;
const Tag = as;
const language = languageForPath(Astro.url.pathname);
const htmlLang = languages.find(({ code }) => code === language)!.htmlLang;
---

<Tag class={className}>
  <span data-locale={language} lang={htmlLang}>{value[language]}</span>
</Tag>

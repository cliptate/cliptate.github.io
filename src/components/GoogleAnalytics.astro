---
// Public GA4 Web stream ID for Cliptate Website (not an API secret).
const measurementId = 'G-YFZGXWWR9V';
const hostname = Astro.site!.hostname;
---

{import.meta.env.PROD && (
  <script is:inline define:vars={{ measurementId, hostname }}>
    // Keep development, previews, and forks out of production reports.
    if (window.location.hostname === hostname) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    }
  </script>
)}

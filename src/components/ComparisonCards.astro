---
import LocalizedText from './LocalizedText.astro';
import { articles, blog, type ComparisonArticle } from '../data/blog';
import { languageForPath, localizedPath } from '../data/languages';
const language = languageForPath(Astro.url.pathname);
interface Props { items?: ComparisonArticle[] }
const { items = articles } = Astro.props;
---

<div class="comparison-grid">
  {items.map((article) => (
    <a class="comparison-card glass-panel" href={localizedPath(`/blog/${article.slug}/`, language)}>
      <p class="eyebrow"><LocalizedText value={article.tag} /></p>
      <div class="comparison-pair" aria-hidden="true">
        <span>Cliptate</span><span class="comparison-versus">vs</span><span>{article.competitor}</span>
      </div>
      <h3><LocalizedText value={article.title} /></h3>
      <p class="lede"><LocalizedText value={article.description} /></p>
      <span class="comparison-read"><LocalizedText value={blog.read} /><span aria-hidden="true">↗</span></span>
    </a>
  ))}
</div>

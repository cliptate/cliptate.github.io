---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ComparisonCards from '../../components/ComparisonCards.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { blog } from '../../data/blog';
import { guide } from '../../data/guide';
---

<BaseLayout title={blog.metaTitle} description={blog.description}>
  <main class="site-shell">
    <SiteHeader />
    <section class="section editorial-hero">
      <p class="eyebrow"><LocalizedText value={blog.kicker} /></p>
      <h1 class="editorial-title"><LocalizedText value={blog.title} /></h1>
      <p class="lede"><LocalizedText value={blog.description} /></p>
    </section>
    <section class="section" aria-labelledby="articles-title">
      <h2 id="articles-title" class="section-title"><LocalizedText value={blog.nav} /></h2>
      <ComparisonCards />
    </section>
    <aside class="editorial-method glass-panel">
      <h2><LocalizedText value={blog.methodTitle} /></h2>
      <p class="lede"><LocalizedText value={blog.method} /></p>
      <p class="article-meta"><LocalizedText value={blog.updated} /> · <time datetime={blog.date}>{blog.date}</time></p>
    </aside>
    <footer class="site-footer">
      <p><LocalizedText value={blog.requirements} /></p>
      <a class="text-link" href={guide.releasesUrl} target="_blank" rel="noreferrer"><LocalizedText value={blog.download} /> ↗</a>
    </footer>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ComparisonCards from '../../components/ComparisonCards.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { articles, blog, cliptateSources, type ComparisonArticle } from '../../data/blog';
import { defaultLanguage } from '../../data/languages';
import { guide } from '../../data/guide';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
interface Props { article: ComparisonArticle }
const { article } = Astro.props as Props;
const title = Object.fromEntries(Object.entries(article.title).map(([code, value]) => [code, `${value} | Cliptate`])) as typeof article.title;
const canonical = new URL(`/blog/${article.slug}/`, Astro.site);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: article.title[defaultLanguage], description: article.description[defaultLanguage],
  datePublished: blog.date, dateModified: blog.date,
  author: { '@type': 'Organization', name: 'Cliptate', url: Astro.site?.toString() },
  mainEntityOfPage: canonical.toString(), inLanguage: 'zh-CN',
};
---

<BaseLayout title={title} description={article.description} type="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <main class="site-shell">
    <SiteHeader />
    <article class="comparison-article">
      <header class="section editorial-hero">
        <a class="text-link" href="/blog/">← <LocalizedText value={blog.back} /></a>
        <p class="eyebrow"><LocalizedText value={article.tag} /></p>
        <h1 class="editorial-title article-title"><LocalizedText value={article.title} /></h1>
        <p class="lede"><LocalizedText value={article.description} /></p>
        <p class="article-meta"><LocalizedText value={blog.updated} /> · <time datetime={blog.date}>{blog.date}</time></p>
      </header>
      <div class="article-body">
        <p class="article-intro"><LocalizedText value={article.intro} /></p>
        <section class="article-section" aria-labelledby="comparison-heading">
          <h2 id="comparison-heading"><LocalizedText value={blog.table} /></h2>
          <div class="comparison-table-scroll" role="region" aria-labelledby="comparison-heading" tabindex="0">
            <table class="comparison-table">
              <thead><tr><th scope="col"><LocalizedText value={blog.dimension} /></th><th scope="col">Cliptate</th><th scope="col">{article.competitor}</th></tr></thead>
              <tbody>{article.rows.map((row) => (
                <tr>
                  <th scope="row"><LocalizedText value={row.label} /></th>
                  <td><LocalizedText value={row.cliptate} /></td>
                  <td><LocalizedText value={row.other} /> <a class="source-reference" href={`#source-${row.source + 1}`}>[{row.source + 1}]</a></td>
                </tr>
              ))}</tbody>
            </table>
          </div>
          <p class="article-note"><LocalizedText value={blog.channelNote} /></p>
          <a class="text-link" href={cliptateSources[0].url} target="_blank" rel="noreferrer">Cliptate · <LocalizedText value={blog.source} /> ↗</a>
        </section>
        {article.sections.map((section) => (
          <section class="article-section">
            <h2><LocalizedText value={section.title} /></h2>
            <p><LocalizedText value={section.body} /></p>
            {section.source !== undefined && <a class="text-link" href={article.sources[section.source].url} target="_blank" rel="noreferrer"><LocalizedText value={blog.source} /> ↗</a>}
          </section>
        ))}
        <section class="article-section">
          <h2><LocalizedText value={blog.choose} /></h2>
          <div class="decision-grid">
            <div class="glass-panel"><h3><LocalizedText value={blog.chooseCliptate} /></h3><p><LocalizedText value={article.cliptateFit} /></p></div>
            <div class="glass-panel"><h3><LocalizedText value={blog.chooseOther} /></h3><p><LocalizedText value={article.otherFit} /></p></div>
          </div>
        </section>
        <section class="article-section trial-panel">
          <h2><LocalizedText value={blog.tryTitle} /></h2>
          <p><LocalizedText value={article.trial} /></p>
        </section>
        <aside class="editorial-method glass-panel">
          <h2><LocalizedText value={blog.methodTitle} /></h2>
          <p><LocalizedText value={blog.method} /></p>
        </aside>
        <section class="article-section source-list" aria-labelledby="sources-heading">
          <h2 id="sources-heading"><LocalizedText value={blog.sourcesTitle} /></h2>
          <ol>{article.sources.map((source, index) => (
            <li id={`source-${index + 1}`}><a class="text-link" href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>
          ))}</ol>
          <ul>{cliptateSources.map((source) => <li><a class="text-link" href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul>
        </section>
        <div class="article-download">
          <a class="cta-primary" href={guide.releasesUrl} target="_blank" rel="noreferrer"><LocalizedText value={blog.download} /></a>
          <p class="article-meta"><LocalizedText value={blog.requirements} /></p>
        </div>
      </div>
    </article>
    <section class="section" aria-labelledby="related-title">
      <h2 class="section-title" id="related-title"><LocalizedText value={blog.related} /></h2>
      <ComparisonCards items={articles.filter((item) => item.slug !== article.slug)} />
    </section>
  </main>
</BaseLayout>

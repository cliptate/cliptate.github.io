---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { changelog, releases, releaseHeading } from '../data/changelog';
import { blog } from '../data/blog';
import { guide } from '../data/guide';
import { languageForPath, localizedPath, serializeJson } from '../data/languages';

const language = languageForPath(Astro.url.pathname);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: changelog.title[language],
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  numberOfItems: releases.length,
  itemListElement: releases.map((release, index) => ({
    '@type': 'ListItem', position: index + 1,
    name: releaseHeading(release, language),
    url: new URL(localizedPath(`/changelog/${release.tag}/`, language), Astro.site).toString(),
  })),
};
---

<BaseLayout title={changelog.metaTitle} description={changelog.description}>
  <script type="application/ld+json" is:inline set:html={serializeJson(structuredData)} />
  <main class="site-shell">
    <SiteHeader />
    <header class="section editorial-hero">
      <p class="eyebrow"><LocalizedText value={changelog.kicker} /></p>
      <h1 class="editorial-title"><LocalizedText value={changelog.title} /></h1>
      <p class="lede"><LocalizedText value={changelog.description} /></p>
    </header>
    <section class="section release-archive" aria-labelledby="releases-heading">
      <h2 id="releases-heading" class="section-title"><LocalizedText value={changelog.archive} /></h2>
      <ol class="release-list">
        {releases.map((release, index) => (
          <li class="release-entry">
            <div class="release-date">
              <time datetime={release.date}>{release.date}</time>
              <span class="release-version">{release.tag}</span>
              {index === 0 && <span class="release-badge"><LocalizedText value={changelog.latest} /></span>}
            </div>
            <article class="glass-panel release-card">
              <h3><a href={localizedPath(`/changelog/${release.tag}/`, language)}><LocalizedText value={release.title} /></a></h3>
              <p class="lede"><LocalizedText value={release.summary} /></p>
              <a class="text-link" href={localizedPath(`/changelog/${release.tag}/`, language)}><LocalizedText value={changelog.read} /> · {release.tag} →</a>
            </article>
          </li>
        ))}
      </ol>
    </section>
    <aside class="editorial-method glass-panel"><p><LocalizedText value={changelog.scope} /></p></aside>
    <footer class="site-footer">
      <p><LocalizedText value={blog.requirements} /></p>
      <a class="text-link" href={guide.releasesUrl} target="_blank" rel="noreferrer"><LocalizedText value={blog.download} /> ↗</a>
    </footer>
  </main>
</BaseLayout>

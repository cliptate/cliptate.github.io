---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { guide } from '../data/guide';
import { siteData } from '../data/site';
import { languageForPath, languages, localizedPath, serializeJson } from '../data/languages';
const language = languageForPath(Astro.url.pathname);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  '@id': new URL(`${localizedPath('/guide/', language)}#faq`, Astro.site).toString(),
  inLanguage: languages.find(({ code }) => code === language)!.htmlLang,
  mainEntity: guide.faq.items.map((item) => ({
    '@type': 'Question', name: item.question[language],
    acceptedAnswer: { '@type': 'Answer', text: item.answer[language] },
  })),
};
const contents = [
  { href: '#download', label: guide.page.install },
  { href: '#models', label: guide.page.models },
  { href: '#cli', label: guide.page.cli },
  { href: '#faq', label: guide.page.faq },
];
---

<BaseLayout title={guide.page.metaTitle} description={guide.page.description}>
  <script type="application/ld+json" is:inline set:html={serializeJson(structuredData)} />
  <main class="site-shell guide-page">
    <SiteHeader />
    <header class="section editorial-hero">
      <p class="eyebrow"><LocalizedText value={guide.links.guide} /></p>
      <h1 class="editorial-title"><LocalizedText value={guide.page.title} /></h1>
      <p class="lede"><LocalizedText value={guide.page.description} /></p>
    </header>
    <div class="guide-layout">
      <nav class="guide-contents" aria-labelledby="contents-title">
        <h2 id="contents-title"><LocalizedText value={guide.page.contents} /></h2>
        {contents.map((item) => <a href={item.href}><LocalizedText value={item.label} /></a>)}
      </nav>
      <div class="guide-content">
    <section class="section" id="download">
      <div class="section-copy section-copy--narrow">
        <p class="eyebrow"><LocalizedText value={guide.download.kicker} /></p>
        <h2 class="section-title"><LocalizedText value={guide.download.title} /></h2>
        <p class="lede"><LocalizedText value={guide.download.requirements} /></p>
      </div>
      <div class="dual-panel download-grid">
        <article class="glass-panel guide-card download-card">
          <h3><LocalizedText value={guide.download.direct.title} /></h3>
          <p class="lede"><LocalizedText value={guide.download.direct.body} /></p>
          <a class="cta-primary" href={guide.releasesUrl} target="_blank" rel="noreferrer"><LocalizedText value={guide.download.direct.cta} /></a>
        </article>
        <article class="glass-panel guide-card download-card">
          <h3><LocalizedText value={guide.download.nightly} /></h3>
          <p class="lede"><LocalizedText value={guide.download.nightlyNote} /></p>
          <a class="cta-secondary" href={guide.nightlyUrl} target="_blank" rel="noreferrer"><LocalizedText value={guide.download.nightly} /></a>
        </article>
      </div>
      <ol class="install-steps">
        {guide.download.steps.map((step) => <li><LocalizedText value={step} /></li>)}
      </ol>
    </section>

    <section class="section" id="models">
      <div class="section-copy section-copy--narrow">
        <p class="eyebrow"><LocalizedText value={guide.models.kicker} /></p>
        <h2 class="section-title"><LocalizedText value={guide.models.title} /></h2>
      </div>
      <div class="guide-grid">
        {guide.models.items.map((item) => (
          <article class="glass-panel guide-card">
            <h3><LocalizedText value={item.title} /></h3>
            <p class="lede"><LocalizedText value={item.body} /></p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="cli">
      <div class="section-copy section-copy--narrow">
        <p class="eyebrow"><LocalizedText value={guide.automation.kicker} /></p>
        <h2 class="section-title"><LocalizedText value={guide.automation.title} /></h2>
        <p class="lede"><LocalizedText value={guide.automation.description} /></p>
      </div>
      <div class="guide-grid">
        {guide.automation.examples.map((example) => (
          <article class="glass-panel guide-card">
            <h3><LocalizedText value={example.title} /></h3>
            <pre><code>{example.code}</code></pre>
          </article>
        ))}
      </div>
      <p class="lede guide-note"><LocalizedText value={guide.automation.note} /></p>
      <a class="text-link" href={guide.cliUrl} target="_blank" rel="noreferrer"><LocalizedText value={guide.automation.link} /> ↗</a>
    </section>

    <section class="section" id="faq">
      <h2 class="section-title"><LocalizedText value={guide.faq.title} /></h2>
      <div class="faq-list">
        {guide.faq.items.map((item) => (
          <details class="glass-panel">
            <summary><LocalizedText value={item.question} /></summary>
            <p class="lede"><LocalizedText value={item.answer} /></p>
          </details>
        ))}
      </div>
    </section>
      </div>
    </div>
    <footer class="site-footer">
      <p><LocalizedText value={siteData.footer.tagline} /></p>
      <div class="footer-links">
        <a class="text-link" href={guide.docsUrl} target="_blank" rel="noreferrer">GitHub · <LocalizedText value={guide.links.guide} /> ↗</a>
        <a class="text-link" href={guide.issuesUrl} target="_blank" rel="noreferrer"><LocalizedText value={guide.links.feedback} /> ↗</a>
      </div>
    </footer>
  </main>
</BaseLayout>

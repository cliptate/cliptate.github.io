---
import '../styles/global.css';
import '../styles/editorial.css';
import type { LocalizedString } from '../data/site';
import { languages, languageForPath, localizedPath, unlocalizedPath, serializeJson } from '../data/languages';
import { blog } from '../data/blog';
import { guide } from '../data/guide';
import { changelog } from '../data/changelog';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title: LocalizedString;
  description: LocalizedString;
  type?: 'website' | 'article';
  published?: string;
  modified?: string;
}

const { title, description, type = 'website', published, modified } = Astro.props;
const language = languageForPath(Astro.url.pathname);
const locale = languages.find(({ code }) => code === language)!;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();
const pageTitle = title[language];
const pageDescription = description[language];
const image = new URL(`/assets/screenshots/home.${language}.jpg`, site).toString();
const path = unlocalizedPath(Astro.url.pathname);
const home = new URL(localizedPath('/', language), site).toString();
const section = path.startsWith('/changelog/') ? { path: '/changelog/', name: changelog.nav[language] }
  : path.startsWith('/blog/') ? { path: '/blog/', name: blog.nav[language] }
  : { path: '/guide/', name: guide.links.guide[language] };
const breadcrumbs = path === '/' ? [] : [
  { '@type': 'ListItem', position: 1, name: blog.home[language], item: home },
  { '@type': 'ListItem', position: 2, name: section.name, item: new URL(localizedPath(section.path, language), site).toString() },
  ...(type === 'article' ? [{ '@type': 'ListItem', position: 3, name: pageTitle, item: canonical }] : []),
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}#organization`, name: 'Cliptate', url: site.toString(), sameAs: ['https://github.com/cliptate/cliptate'] },
    { '@type': 'WebSite', '@id': `${site}#website`, name: 'Cliptate', url: site.toString(), publisher: { '@id': `${site}#organization` } },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: pageTitle, description: pageDescription, inLanguage: locale.htmlLang, isPartOf: { '@id': `${site}#website` }, ...(breadcrumbs.length ? { breadcrumb: { '@id': `${canonical}#breadcrumbs` } } : {}) },
    ...(breadcrumbs.length ? [{ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: breadcrumbs }] : []),
  ],
};
---

<!doctype html>
<html lang={locale.htmlLang} data-lang={language}>
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {languages.map(({ code, htmlLang }) => <link rel="alternate" hreflang={htmlLang} href={new URL(localizedPath(Astro.url.pathname, code), site).toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(Astro.url.pathname, 'zh'), site).toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="Cliptate" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1600" />
    <meta property="og:image:alt" content={guide.screenshot.alt[language]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={guide.screenshot.alt[language]} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={serializeJson(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
